  "faq": {
    "title": "Frequently Asked Questions",
    "items": [
      {
        "question": "What is the process of buying a home?",
        "answer": "We start with an initial consultation to understand your requirements, followed by curated property viewings. Once you find a match, we handle negotiations and guide you through the conveyancing process to completion."
      },
      {
        "question": "How do you value my property?",
        "answer": "Our valuations are evidence-based, drawing on recent comparable sales, current market demand, and the unique characteristics of your home and street."
      },
      {
        "question": "Do you offer off-market property listings?",
        "answer": "Yes. A significant portion of our transactions are conducted off-market for clients who prefer discretion. Please contact us to register as a private buyer."
      },
      {
        "question": "What fees should I expect as a seller?",
        "answer": "We operate on a clear, competitive commission structure agreed upon during our initial appraisal. There are no hidden marketing fees or upfront costs."
      },
      {
        "question": "Can you assist with international relocations?",
        "answer": "Absolutely. We regularly assist international clients moving to the UK, offering virtual viewings and comprehensive advice on the local buying process."
      }
    ]
  },
