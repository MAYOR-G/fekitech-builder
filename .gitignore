# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
/.data/
/raw-templates/
!/raw-templates/
/raw-templates/*
!/raw-templates/burger-dark-premium/
!/raw-templates/burger-dark-premium/**
!/raw-templates/burger-light-clean/
!/raw-templates/burger-light-clean/**
!/raw-templates/pizza-dark-premium/
!/raw-templates/pizza-dark-premium/**
!/raw-templates/pizza-light-clean/
!/raw-templates/pizza-light-clean/**
!/raw-templates/cleaning-agency-premium/
!/raw-templates/cleaning-agency-premium/**
!/raw-templates/roofing-agency-premium/
!/raw-templates/roofing-agency-premium/**
!/raw-templates/premium-restaurant/
!/raw-templates/premium-restaurant/**
!/raw-templates/fast-food-chicken-tacos/
!/raw-templates/fast-food-chicken-tacos/**
!/raw-templates/cake-bakery-premium/
!/raw-templates/cake-bakery-premium/**
!/raw-templates/pastries-snacks-premium/
!/raw-templates/pastries-snacks-premium/**
